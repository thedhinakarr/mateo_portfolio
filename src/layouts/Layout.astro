---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tvättbjörnen | Takvård, fasadtvätt, städning och invändig bilvård",
  description = "Mateo hjälper privatpersoner och företag med takrengöring, fasadtvätt, flyttstädning, lokalstädning och invändig bilrekond. Be om en kostnadsfri offert."
} = Astro.props;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta name="theme-color" content="#18733a" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
